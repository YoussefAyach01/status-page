PORT=3350
# Secret for POST /admin/keys. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-string
# SQLite file (node:sqlite). Keep on a persistent disk.
DB_PATH=./data/status.db
# NEVER set to 1 in production: allows monitoring localhost/private IPs (SSRF). Local testing only.
ALLOW_PRIVATE_TARGETS=0
# Run the background checker inside the API process (1) or API only (0)
RUN_CHECKER=1
